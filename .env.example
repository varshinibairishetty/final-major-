# ==============================================================================
# Multimodal AI-Based Smart Traffic Management and Accident Prediction System
# Root Environment Variables Configuration Example
# ==============================================================================
# Copy this file to .env before starting the services.
# Never commit real credentials or .env files to version control.

# Backend Server Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# External API Integrations
# TomTom Traffic API Key (obtain from https://developer.tomtom.com/)
TOMTOM_API_KEY=your_tomtom_api_key_here

# Open-Meteo Weather API Base URL (free tier requires no API key by default)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# Cache / Polling Configuration
TRAFFIC_DATA_TTL_SECONDS=300
WEATHER_DATA_TTL_SECONDS=900
