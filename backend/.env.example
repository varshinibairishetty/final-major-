# ==============================================================================
# Backend Environment Configuration
# ==============================================================================
# Copy this file to backend/.env and populate with your credentials.

# Server Settings
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# External Traffic API (TomTom)
# Register and obtain key from: https://developer.tomtom.com/
TOMTOM_API_KEY=your_tomtom_api_key_here
TOMTOM_BASE_URL=https://api.tomtom.com

# External Weather API (Open-Meteo)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# Cache & Request Controls
REQUEST_TIMEOUT_SECONDS=5.0
TRAFFIC_CACHE_TTL_SECONDS=300
WEATHER_CACHE_TTL_SECONDS=900
